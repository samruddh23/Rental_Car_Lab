{
  "info": {
    "name": "ApexDrive Bharat - MERN Car Rental API (Exp 5, 6, 7)",
    "description": "API collection for demonstrating REST endpoints, MongoDB CRUD operations, and JWT authentication in VS Code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verifies server is online and checks MongoDB connection status."
      }
    },
    {
      "name": "Exp 6 - Vehicles CRUD (MongoDB)",
      "item": [
        {
          "name": "GET All Vehicles (Read)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": ["{{baseUrl}}"],
              "path": ["cars"]
            }
          }
        },
        {
          "name": "GET Vehicles by Category (Read with Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars?category=suv",
              "host": ["{{baseUrl}}"],
              "path": ["cars"],
              "query": [
                { "key": "category", "value": "suv" }
              ]
            }
          }
        },
        {
          "name": "GET Vehicle by ID (Read Single)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/1",
              "host": ["{{baseUrl}}"],
              "path": ["cars", "1"]
            }
          }
        },
        {
          "name": "POST Create Vehicle (CRUD Create)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Tata\",\n  \"model\": \"Harrier Dark Edition\",\n  \"type\": \"Dynamic Indian SUV\",\n  \"category\": \"suv\",\n  \"price\": 3199,\n  \"transmission\": \"Automatic\",\n  \"passengers\": 5,\n  \"fuel\": \"Kryotec 2.0L Diesel\",\n  \"image\": \"https://images.unsplash.com/photo-1549399542-7e3f8b79c341\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cars",
              "host": ["{{baseUrl}}"],
              "path": ["cars"]
            }
          }
        },
        {
          "name": "PUT Update Vehicle Rate (CRUD Update)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 3999,\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cars/1",
              "host": ["{{baseUrl}}"],
              "path": ["cars", "1"]
            }
          }
        },
        {
          "name": "DELETE Vehicle (CRUD Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/6",
              "host": ["{{baseUrl}}"],
              "path": ["cars", "6"]
            }
          }
        }
      ]
    },
    {
      "name": "Exp 6 - Bookings CRUD (MongoDB)",
      "item": [
        {
          "name": "GET All Bookings (Read)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "POST Create Booking (CRUD Create)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": 1,\n  \"carMake\": \"Mahindra\",\n  \"carModel\": \"Thar 4x4\",\n  \"pickupLocation\": \"Mumbai Central Hub\",\n  \"returnLocation\": \"Goa Coastal Hub\",\n  \"pickupDate\": \"2026-10-01\",\n  \"returnDate\": \"2026-10-05\",\n  \"days\": 4,\n  \"customerName\": \"Samruddh Jadhav\",\n  \"customerEmail\": \"samruddh.jadhav@ves.ac.in\",\n  \"customerPhone\": \"+91 98201 45678\",\n  \"licenseNumber\": \"MH02-2023-0091823\",\n  \"totalAmount\": 16515\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "PUT Update Booking Status (CRUD Update)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/BK-IN-670793/status",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "BK-IN-670793", "status"]
            }
          }
        },
        {
          "name": "GET Admin Stats (MongoDB Aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Exp 7 - JWT Authentication & Security",
      "item": [
        {
          "name": "POST User Signup (Bcrypt Hash & JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Samruddh Jadhav\",\n  \"email\": \"samruddh.jadhav@ves.ac.in\",\n  \"phone\": \"+91 98201 45678\",\n  \"city\": \"Mumbai\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "POST User Login (Get JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"samruddh.jadhav@ves.ac.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "GET Protected Profile (Verify JWT Bearer Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    }
  ]
}
